    - target: {fileID: 744068930724076913, guid: 9e63b7dac64645640925bb89b012fcfd, type: 3}
      propertyPath: m_text
      value: "        <b>\u9ED1\u8109\u91D1\u6591\u8776\uFF08\u5B66\u540DDanaus plexippus\uFF09</b>\uFF0C\u53C8\u540D\u5E1D\u738B\u8776\uFF0C\u5C5E\u9CDE\u7FC5\u76EE\u86F1\u8776\u79D1\u6591\u8776\u5C5E\uFF0C\u662F\u5317\u7F8E\u6D32\u6807\u5FD7\u6027\u7269\u79CD\uFF0C\u7FC5\u5C55
        8.9-10.2 \u5398\u7C73\u3002\u7FC5\u8180\u4EE5\u9C9C\u8273\u6A59\u7EA2\u8272\u4E3A\u5E95\u8272\uFF0C\u5E03\u6EE1\u9ED1\u8272\u8109\u7EDC\uFF0C\u8FB9\u7F18\u5D4C\u6709\u5BBD\u9614\u9ED1\u5E26\uFF0C\u5E26\u5185\u6574\u9F50\u6392\u5217\u4E24\u5217\u767D\u8272\u6591\u70B9\uFF0C\u8272\u5F69\u5BF9\u6BD4\u5F3A\u70C8\uFF0C\u4E0D\u4EC5\u6781\u5177\u89C2\u8D4F\u6027\uFF0C\u66F4\u4F5C\u4E3A\u8B66\u6212\u8272\u5411\u5929\u654C\u4F20\u9012
        \u201C\u6709\u6BD2\u4E0D\u53EF\u98DF\u201D \u7684\u4FE1\u53F7 \u2014\u2014
        \u5176\u5E7C\u866B\u4EE5\u542B\u5F3A\u5FC3\u82F7\u6BD2\u7D20\u7684\u9A6C\u5229\u7B4B\u5C5E\u690D\u7269\u4E3A\u98DF\uFF0C\u6BD2\u7D20\u4F1A\u79EF\u7D2F\u81F3\u6210\u866B\u9636\u6BB5\u3002\r\n       
        \u9ED1\u8109\u91D1\u6591\u8776\u6700\u9707\u64BC\u4E4B\u5904\u5728\u4E8E\u5176\u53F2\u8BD7\u7EA7\u7684\u8FC1\u5F99\u3002\u6BCF\u5E74\u79CB\u5B63\uFF0C\u5317\u7F8E\u4E1C\u90E8\u79CD\u7FA4\u4ECE\u52A0\u62FF\u5927\u3001\u7F8E\u56FD\u5317\u90E8\u51FA\u53D1\uFF0C\u8DE8\u8D8A
        4000 \u516C\u91CC\u62B5\u8FBE\u58A8\u897F\u54E5\u4E2D\u90E8\u7684\u51B7\u6749\u6797\u8D8A\u51AC\uFF0C\u6625\u5B63\u518D\u53CD\u5411\u8FC1\u5F99\uFF0C\u6574\u4E2A\u8FC7\u7A0B\u9700\u5386\u7ECF
        4-5 \u4EE3\u63A5\u529B\u5B8C\u6210\uFF0C\u662F\u6606\u866B\u754C\u72EC\u4E00\u65E0\u4E8C\u7684\u8DE8\u4EE3\u957F\u8DDD\u79BB\u8FC1\u5F99\u73B0\u8C61\u3002\r\n\r       
        \u7136\u800C\uFF0C\u73B0\u4EE3\u519C\u4E1A\u53D1\u5C55\u5BFC\u81F4\u9A6C\u5229\u7B4B\u6816\u606F\u5730\u9510\u51CF\uFF0C\u52A0\u4E4B\u6C14\u5019\u53D8\u5316\u3001\u6740\u866B\u5242\u6EE5\u7528\u7B49\u56E0\u7D20\uFF0C\u9ED1\u8109\u91D1\u6591\u8776\u79CD\u7FA4\u6570\u91CF\u6025\u5267\u4E0B\u964D\uFF0C\u5DF2\u88AB\u5217\u5165\u6FD2\u5371\u7269\u79CD\u3002\u5176\u751F\u5B58\u56F0\u5883\u4E0D\u4EC5\u5173\u4E4E\u4E00\u4E2A\u7269\u79CD\u7684\u547D\u8FD0\uFF0C\u66F4\u6572\u54CD\u4E86\u5168\u7403\u751F\u6001\u7CFB\u7EDF\u4FDD\u62A4\u7684\u8B66\u949F\uFF0C\u6210\u4E3A\u751F\u7269\u591A\u6837\u6027\u4FDD\u62A4\u7684\u91CD\u8981\u8BAE\u9898\u3002"
      objectReference: {fileID: 0}
